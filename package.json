{
  "name": "lattice-sheet-studio",
  "version": "0.7.36",
  "description": "Independent local spreadsheet editor with formulas and XLSX exchange",
  "author": "Sheet Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/vite.cjs --host 127.0.0.1 --port 5192",
    "build": "node scripts/vite.cjs build",
    "preview": "node scripts/vite.cjs preview --host 127.0.0.1 --port 5192",
    "desktop": "npm run build && node scripts/launch.cjs",
    "start": "node scripts/launch.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "package:dir": "npm run build && node scripts/package.cjs --dir",
    "test": "node --test tests/*.test.mjs",
    "test:updates": "node --test tests/updates/studio-updater.cjs",
    "test:desktop": "npm run build && node scripts/electron-smoke.cjs",
    "package:mac": "npm run build && node scripts/package.cjs --mac",
    "package:win": "npm run build && node scripts/package.cjs --win",
    "runtime:install": "node node_modules/electron/install.js",
    "package:linux": "npm run build && node scripts/package.cjs --linux",
    "test:parity-ui": "npm run build && node tests/ui-parity-audit.mjs",
    "test:interop:libreoffice": "node tests/libreoffice-interop.mjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "4.6.1",
    "@xmldom/xmldom": "0.9.12",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "electron": "42.11.15",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "resedit": "1.7.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "sheet-studio"
}
